.filters {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 26rpx;
}

.chip.is-active {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.grid-item {
  width: calc((100% - 24rpx) / 2);
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
