.header {
  margin-bottom: 28rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.brand-accent {
  color: var(--brand);
}

.hero {
  background: var(--card);
  border-radius: 32rpx;
  overflow: hidden;
}

.hero-canvas {
  height: 360rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx;
  box-sizing: border-box;
}

.day-badge {
  align-self: flex-start;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  backdrop-filter: blur(6rpx);
}

.palette {
  display: flex;
  gap: 12rpx;
}

.palette-chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.hero-body {
  padding: 28rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.hero-meta {
  font-size: 24rpx;
  margin: 6rpx 0 16rpx;
}

.hero-desc {
  font-size: 27rpx;
  color: var(--ink-2);
}

.tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}

.btn-fav {
  background: var(--brand);
  color: #fff;
}

.btn-fav.is-on {
  background: #ffd166;
  color: var(--ink);
}

.btn-ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(108, 92, 231, 0.3);
}
